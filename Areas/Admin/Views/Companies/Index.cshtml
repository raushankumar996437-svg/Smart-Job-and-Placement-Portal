@model List<SmartHire.Models.Company>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Companies & Corporate Partner Approvals";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0"><i class="bi bi-buildings-fill text-success me-2"></i>Corporate Partners & Verification</h3>
        <p class="text-secondary small mb-0">Approve company registrations, edit profile records, or add new recruiting companies</p>
    </div>
    <a asp-action="Create" class="btn btn-success rounded-pill px-3 py-2 fw-semibold shadow-sm">
        <i class="bi bi-plus-circle me-1"></i>Add New Company
    </a>
</div>

<div class="cyber-card p-4 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Company Name</th>
                    <th>Official Email</th>
                    <th>Industry</th>
                    <th>Website</th>
                    <th>Jobs Posted</th>
                    <th>Status</th>
                    <th class="text-end">Admin Controls</th>
                </tr>
            </thead>
            <tbody class="small">
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <strong class="text-dark d-block">@c.CompanyName</strong>
                            <small class="text-muted">ID: #@c.Id &bull; Added: @c.CreatedAt.ToString("dd MMM yyyy")</small>
                        </td>
                        <td>@c.OfficialEmail</td>
                        <td><span class="badge bg-light text-dark border">@c.Industry</span></td>
                        <td>
                            @if (!string.IsNullOrEmpty(c.Website))
                            {
                                <a href="@c.Website" target="_blank" class="text-decoration-none text-primary">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Visit
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">&mdash;</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-primary bg-opacity-10 text-primary font-monospace">@c.Jobs.Count Jobs</span>
                        </td>
                        <td>
                            @if (c.ApprovalStatus == "Approved")
                            {
                                <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 px-2.5 py-1">
                                    <i class="bi bi-check-circle-fill me-1"></i>Approved
                                </span>
                            }
                            else if (c.ApprovalStatus == "Pending")
                            {
                                <span class="badge bg-warning bg-opacity-15 text-dark border border-warning border-opacity-25 px-2.5 py-1">
                                    <i class="bi bi-hourglass-split me-1"></i>Pending Verification
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-15 text-danger border border-danger border-opacity-25 px-2.5 py-1">
                                    Rejected
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <!-- Status Toggle Button -->
                                <form asp-action="ToggleStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.Id" />
                                    @if (c.ApprovalStatus == "Approved")
                                    {
                                        <input type="hidden" name="status" value="Pending" />
                                        <button type="submit" class="btn btn-xs btn-outline-warning py-1 px-2 rounded" title="Suspend Verification">
                                            Suspend
                                        </button>
                                    }
                                    else
                                    {
                                        <input type="hidden" name="status" value="Approved" />
                                        <button type="submit" class="btn btn-xs btn-success py-1 px-2 rounded" title="Approve for Recruitment">
                                            Approve
                                        </button>
                                    }
                                </form>

                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-xs btn-outline-primary py-1 px-2 rounded">
                                    Edit
                                </a>

                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this company and its job listings permanently?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="btn btn-xs btn-outline-danger py-1 px-2 rounded">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
