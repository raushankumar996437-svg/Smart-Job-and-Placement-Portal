@model SmartHire.Models.Company
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Edit Company - {Model.CompanyName}";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="cyber-card p-4 p-md-5 shadow-sm">
            <h4 class="fw-bold text-dark mb-1"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Company Details</h4>
            <p class="text-secondary small mb-4">Modify verified company profile and approval status in SQL Server</p>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />

                <div class="mb-3">
                    <label asp-for="CompanyName" class="form-label small fw-semibold text-secondary">Company Name</label>
                    <input asp-for="CompanyName" class="form-control" />
                    <span asp-validation-for="CompanyName" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="OfficialEmail" class="form-label small fw-semibold text-secondary">Official Email</label>
                        <input asp-for="OfficialEmail" class="form-control" />
                        <span asp-validation-for="OfficialEmail" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Website" class="form-label small fw-semibold text-secondary">Website URL</label>
                        <input asp-for="Website" class="form-control" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Industry" class="form-label small fw-semibold text-secondary">Industry Sector</label>
                        <input asp-for="Industry" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ApprovalStatus" class="form-label small fw-semibold text-secondary">Approval Status</label>
                        <select asp-for="ApprovalStatus" class="form-select">
                            <option value="Approved">Approved</option>
                            <option value="Pending">Pending</option>
                            <option value="Rejected">Rejected</option>
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label small fw-semibold text-secondary">Company Overview</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="d-flex justify-content-between pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                        <i class="bi bi-save me-1"></i>Save Changes to Database
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
