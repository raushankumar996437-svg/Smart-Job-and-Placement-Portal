@model SmartHire.ViewModels.AdminLoginViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Administrator Login";
}

<div class="row justify-content-center py-5">
    <div class="col-lg-4 col-md-6">
        <div class="cyber-card p-4 p-md-5 shadow-lg border-danger border-opacity-50">
            <div class="text-center mb-4">
                <span class="rounded-circle bg-danger bg-opacity-10 text-danger p-3 d-inline-flex mb-3">
                    <i class="bi bi-shield-lock-fill fs-2"></i>
                </span>
                <h3 class="fw-bold text-dark tracking-tight">Admin Console Sign In</h3>
                <p class="text-secondary small">Authorized placement officers and deans only</p>
            </div>

            <form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small text-secondary">Keep admin session active</label>
                </div>

                <button type="submit" class="btn btn-danger w-100 py-2.5 fw-bold shadow">
                    <i class="bi bi-shield-check me-2"></i>Authenticate as Administrator
                </button>
            </form>

            <div class="mt-4 pt-3 border-top text-center">
                <small class="text-muted d-block mb-2">Default Seeded Admin Credentials:</small>
                <code class="d-block small bg-light p-2 rounded border mb-3">admin@smarthire.local / Admin@2026!</code>
                <a asp-action="Register" class="text-danger fw-semibold small text-decoration-none">
                    Register New Administrator (Requires Security Key) &rarr;
                </a>
            </div>
        </div>
    </div>
</div>
