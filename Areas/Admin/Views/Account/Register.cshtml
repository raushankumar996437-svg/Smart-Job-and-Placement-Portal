@model SmartHire.ViewModels.AdminRegisterViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Register Administrator";
}

<div class="row justify-content-center py-5">
    <div class="col-lg-5 col-md-7">
        <div class="cyber-card p-4 p-md-5 shadow-lg border-danger border-opacity-50">
            <div class="text-center mb-4">
                <span class="rounded-circle bg-danger bg-opacity-10 text-danger p-3 d-inline-flex mb-3">
                    <i class="bi bi-person-badge fs-2"></i>
                </span>
                <h3 class="fw-bold text-dark tracking-tight">Register New Administrator</h3>
                <p class="text-secondary small">Protected institutional registration with security verification</p>
            </div>

            <form asp-area="Admin" asp-controller="Account" asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="FullName" class="form-control" placeholder="Dr. S. K. Sharma" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="Email" class="form-control" placeholder="officer@college.edu" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Department" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="Department" class="form-control" />
                </div>

                <!-- Admin Security Key Protection -->
                <div class="mb-4 p-3 bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded-3">
                    <label asp-for="SecurityKey" class="form-label small fw-bold text-danger"></label>
                    <input asp-for="SecurityKey" type="password" class="form-control" placeholder="Enter Secret Master Admin Key" />
                    <small class="text-muted d-block mt-1">Institutional verification key: <code>SmartAdmin2026!</code></small>
                    <span asp-validation-for="SecurityKey" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-danger w-100 py-2.5 fw-bold shadow">
                    <i class="bi bi-shield-plus me-1"></i>Create Verified Admin Account
                </button>
            </form>

            <div class="mt-4 pt-3 border-top text-center">
                <a asp-action="Login" class="text-secondary small text-decoration-none">
                    Already have an admin account? <strong class="text-danger">Sign In</strong>
                </a>
            </div>
        </div>
    </div>
</div>
