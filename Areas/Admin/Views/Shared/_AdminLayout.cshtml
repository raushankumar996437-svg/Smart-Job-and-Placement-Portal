@using Microsoft.AspNetCore.Http
@{
    var adminName = Context.Session.GetString("UserName") ?? "Chief Placement Officer";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartHire Central Admin Console</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .admin-sidebar {
            width: 260px;
            min-height: calc(100vh - 58px);
            background: #0b1120;
            border-right: 1px solid rgba(255, 255, 255, 0.1);
        }
        .admin-nav-link {
            color: #94a3b8;
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.9rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
        }
        .admin-nav-link:hover, .admin-nav-link.active {
            color: #ffffff;
            background: rgba(239, 68, 68, 0.15);
            border-left: 3px solid #ef4444;
        }
    </style>
</head>
<body class="bg-light">
    <!-- Admin Topbar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-2 border-bottom border-danger border-opacity-50" style="background: #090c15 !important;">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <span class="rounded bg-danger text-white p-1.5 px-2 font-monospace fs-6">ADMIN</span>
                    <span class="fs-5 tracking-tight font-monospace text-white">Smart<span class="text-danger">Hire</span> Placement Cell</span>
                </a>

                <div class="d-flex align-items-center gap-3">
                    <div class="d-none d-md-block text-end">
                        <small class="text-secondary d-block font-monospace" style="font-size: 0.75rem;">CONNECTED DATABASE</small>
                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">.\SQLEXPRESS &bull; SmartHireDB</span>
                    </div>

                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary text-light">
                        <i class="bi bi-box-arrow-up-right me-1"></i>View Public Portal
                    </a>
                    
                    <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3 fw-semibold">
                            <i class="bi bi-power me-1"></i>Sign Out
                        </button>
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <div class="d-flex">
        <!-- Persistent Admin Sidebar -->
        <aside class="admin-sidebar p-3 d-none d-lg-block">
            <div class="mb-4 px-2">
                <small class="text-secondary text-uppercase fw-bold font-monospace" style="font-size: 0.7rem;">MANAGEMENT MODULES</small>
            </div>
            <nav class="d-flex flex-column gap-1">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="admin-nav-link">
                    <i class="bi bi-grid-1x2-fill text-danger"></i>
                    <span>Overview Dashboard</span>
                </a>
                <a asp-area="Admin" asp-controller="Companies" asp-action="Index" class="admin-nav-link">
                    <i class="bi bi-buildings-fill text-success"></i>
                    <span>Companies & Approvals</span>
                </a>
                <a asp-area="Admin" asp-controller="Students" asp-action="Index" class="admin-nav-link">
                    <i class="bi bi-mortarboard-fill text-primary"></i>
                    <span>Students Directory</span>
                </a>
                <a asp-area="Admin" asp-controller="Recruiters" asp-action="Index" class="admin-nav-link">
                    <i class="bi bi-people-fill text-info"></i>
                    <span>Recruiters Directory</span>
                </a>
                <a asp-area="Admin" asp-controller="Jobs" asp-action="Index" class="admin-nav-link">
                    <i class="bi bi-briefcase-fill text-warning"></i>
                    <span>Jobs & Openings</span>
                </a>
                <a asp-area="Admin" asp-controller="Applications" asp-action="Index" class="admin-nav-link">
                    <i class="bi bi-journal-check text-danger"></i>
                    <span>Applications Tracker</span>
                </a>
                <a asp-area="" asp-controller="Reports" asp-action="Analytics" class="admin-nav-link">
                    <i class="bi bi-graph-up-arrow text-info"></i>
                    <span>Placement Reports & CSV</span>
                </a>
            </nav>
        </aside>

        <!-- Main Workspace -->
        <main class="flex-grow-1 p-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-info-circle-fill fs-5"></i>
                    <div>@TempData["InfoMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
