@model SmartHire.ViewModels.AiAnalysisResultViewModel
@{
    ViewData["Title"] = "AI Career Copilot & ATS Matcher - SmartHire AI";
    var req = ViewBag.Request as SmartHire.ViewModels.AiAnalysisRequestViewModel ?? new SmartHire.ViewModels.AiAnalysisRequestViewModel();
}

<div class="bg-ai-gradient text-white py-5 position-relative overflow-hidden">
    <div class="container py-lg-3">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-white bg-opacity-10 border border-white border-opacity-25 mb-3">
                    <span class="spinner-grow spinner-grow-sm text-warning" role="status"></span>
                    <span class="text-white small fw-bold tracking-wider font-monospace">SMARTHIRE NEURAL MATCH ENGINE v2.0</span>
                </div>
                <h1 class="display-4 fw-extrabold tracking-tight mb-3">
                    AI Career Copilot & <span class="text-info">ATS Resume Scorer</span>
                </h1>
                <p class="lead text-light opacity-90 mb-0">
                    Input your verified technical stack and target job profile. Our rule-based AI engine analyzes keyword saturation, calculates placement ATS compatibility, highlights skill gaps, and generates predicted technical interview questions.
                </p>
            </div>
            <div class="col-lg-4 text-center">
                <div class="p-4 rounded-4 bg-dark bg-opacity-50 border border-info border-opacity-25 shadow-lg d-inline-block ai-pulse-orb">
                    <div class="display-2 text-info fw-bold mb-1 font-monospace">@Model.OverallMatchScore%</div>
                    <div class="text-uppercase fw-bold text-light small tracking-wider">Overall Match Index</div>
                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 mt-2 px-3 py-1">@Model.MatchCategory</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        <!-- Left Column: Input Simulator -->
        <div class="col-lg-5">
            <div class="cyber-card p-4 shadow-sm mb-4">
                <h4 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-sliders2 text-primary"></i>
                    <span>Candidate Profile & Target</span>
                </h4>
                <p class="text-secondary small mb-3">Tweak your skills or target role below to regenerate real-time AI scoring:</p>

                <form asp-action="Assistant" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Target Job Role</label>
                        <input name="TargetRole" value="@req.TargetRole" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Current CGPA</label>
                        <input name="StudentCGPA" type="number" step="0.1" value="@req.StudentCGPA" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Candidate Technical Skills</label>
                        <textarea name="StudentSkills" rows="4" class="form-control font-monospace text-xs">@req.StudentSkills</textarea>
                        <small class="text-muted">Separate skills with commas.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Resume Summary / Highlights</label>
                        <textarea name="ResumeSummary" rows="3" class="form-control small">@req.ResumeSummary</textarea>
                    </div>

                    <button type="submit" class="btn cyber-btn-ai w-100 py-2.5 fw-bold shadow">
                        <i class="bi bi-cpu me-2"></i>Run AI ATS Evaluation
                    </button>
                </form>
            </div>

            <!-- ATS Quick Gauge Card -->
            <div class="cyber-card p-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold text-dark"><i class="bi bi-file-earmark-check text-success me-2"></i>ATS Parser Compatibility</span>
                    <span class="badge bg-primary text-white font-monospace">@Model.AtsReadinessScore%</span>
                </div>
                <div class="progress mb-3" style="height: 10px;">
                    <div class="progress-bar bg-gradient" style="width: @Model.AtsReadinessScore%; background: linear-gradient(90deg, #06b6d4, #10b981);" role="progressbar"></div>
                </div>
                <p class="text-secondary small mb-0">
                    High parsing confidence. Your resume layout and keyword distribution match automated applicant tracking system (ATS) filters used by Fortune 500 recruiters.
                </p>
            </div>
        </div>

        <!-- Right Column: AI Analysis Breakdown -->
        <div class="col-lg-7">
            <!-- Skill Alignment Section -->
            <div class="cyber-card p-4 shadow-sm mb-4">
                <h4 class="fw-bold text-dark mb-3"><i class="bi bi-bullseye text-primary me-2"></i>Skill Matrix Alignment</h4>
                
                <div class="mb-4">
                    <label class="small fw-bold text-success text-uppercase d-block mb-2">
                        <i class="bi bi-check-circle-fill me-1"></i> Verified Matching Skills (@Model.MatchedSkills.Count)
                    </label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var s in Model.MatchedSkills)
                        {
                            <span class="badge neon-badge-success fs-7"><i class="bi bi-check2 me-1"></i>@s</span>
                        }
                    </div>
                </div>

                @if (Model.MissingSkills.Any())
                {
                    <div>
                        <label class="small fw-bold text-danger text-uppercase d-block mb-2">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Recommended Skills to Bridge (+15% score increase)
                        </label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var s in Model.MissingSkills)
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 fs-7">
                                    <i class="bi bi-plus me-1"></i>@s
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Actionable Recommendations -->
            <div class="cyber-card p-4 shadow-sm mb-4">
                <h4 class="fw-bold text-dark mb-3"><i class="bi bi-lightbulb text-warning me-2"></i>AI Resume Optimization Tips</h4>
                <ul class="list-unstyled d-flex flex-column gap-3 mb-0">
                    @foreach (var rec in Model.AiRecommendations)
                    {
                        <li class="d-flex align-items-start gap-2 text-secondary small">
                            <i class="bi bi-arrow-right-circle-fill text-primary mt-1"></i>
                            <div>@rec</div>
                        </li>
                    }
                </ul>
            </div>

            <!-- Predicted Technical Interview Questions -->
            <div class="cyber-card p-4 shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold text-dark mb-0"><i class="bi bi-chat-square-quote text-info me-2"></i>Predicted Interview Questions</h4>
                    <span class="badge bg-info bg-opacity-10 text-info">Role-Specific</span>
                </div>
                <p class="text-secondary small mb-3">Based on your C# / .NET profile, recruiters are statistically most likely to ask:</p>
                <div class="accordion" id="accordionQuestions">
                    @for (int i = 0; i < Model.PredictedInterviewQuestions.Count; i++)
                    {
                        <div class="accordion-item border rounded-3 mb-2 overflow-hidden">
                            <h2 class="accordion-header" id="heading@(i)">
                                <button class="accordion-button collapsed py-2.5 small fw-semibold text-dark bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@(i)">
                                    Q@(i + 1): @Model.PredictedInterviewQuestions[i]
                                </button>
                            </h2>
                            <div id="collapse@(i)" class="accordion-collapse collapse" data-bs-parent="#accordionQuestions">
                                <div class="accordion-body small text-secondary bg-white">
                                    <strong>AI Tip:</strong> Answer using the STAR method (Situation, Task, Action, Result). Mention real-world code implementation from your SmartHire project to prove hands-on mastery.
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Top AI-Matched Opportunities -->
            <div class="cyber-card p-4 shadow-sm">
                <h4 class="fw-bold text-dark mb-3"><i class="bi bi-stars text-warning me-2"></i>Recommended Openings Based on Your Score</h4>
                <div class="d-flex flex-column gap-3">
                    @foreach (var j in Model.RecommendedJobs)
                    {
                        <div class="p-3 rounded-3 bg-light border d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h6 class="fw-bold text-dark mb-1">@j.Title</h6>
                                <p class="text-primary small mb-0">@j.CompanyName &bull; <i class="bi bi-geo-alt"></i> @j.Location</p>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge bg-success bg-opacity-15 text-success fw-bold font-monospace">@j.AiMatchPercent% Fit</span>
                                <a asp-controller="Jobs" asp-action="Details" asp-route-id="@j.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    View & Apply
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>
