@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 text-center">
            <div class="card shadow-sm border-danger border-opacity-25 rounded-4 p-4 p-md-5">
                <div class="display-1 text-danger mb-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h1 class="h2 fw-bold text-dark mb-2">An unexpected error occurred</h1>
                <p class="text-secondary mb-4">
                    Our team has been notified. Please try refreshing the page or navigating back to safety.
                </p>

                @if (Model?.ShowRequestId == true)
                {
                    <div class="alert alert-secondary py-2 px-3 text-start mb-4">
                        <small class="fw-bold d-block text-dark">Request ID for support tracing:</small>
                        <code class="text-break">@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-house-door me-2"></i>Return to Home
                    </a>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-envelope me-2"></i>Contact Support
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
