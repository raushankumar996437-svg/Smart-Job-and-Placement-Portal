@model SmartHire.ViewModels.JobApplyViewModel
@{
    ViewData["Title"] = $"Apply for {Model.JobTitle} - SmartHire AI";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="cyber-card p-4 p-md-5 shadow-lg">
                <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                    <span class="rounded-circle bg-primary bg-opacity-10 text-primary p-3">
                        <i class="bi bi-send-fill fs-2"></i>
                    </span>
                    <div>
                        <h3 class="fw-bold text-dark tracking-tight mb-0">Apply for @Model.JobTitle</h3>
                        <p class="text-primary small mb-0 fw-semibold">@Model.CompanyName &bull; Campus Drive Application</p>
                    </div>
                </div>

                <!-- AI Score Banner -->
                <div class="alert alert-info border-0 rounded-4 d-flex align-items-center justify-content-between p-3 mb-4" style="background: rgba(6, 182, 212, 0.12);">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-stars text-info fs-4"></i>
                        <div>
                            <strong class="text-dark d-block small">AI Fit Score Calculated:</strong>
                            <small class="text-secondary">Your profile matches required job criteria.</small>
                        </div>
                    </div>
                    <span class="badge bg-success text-white px-3 py-1.5 font-monospace fs-7">@Model.CalculatedAiScore% Match</span>
                </div>

                <form asp-action="Apply" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="JobId" />
                    <input type="hidden" asp-for="JobTitle" />
                    <input type="hidden" asp-for="CompanyName" />
                    <input type="hidden" asp-for="CalculatedAiScore" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="StudentName" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="StudentName" class="form-control" />
                            <span asp-validation-for="StudentName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CGPA" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="CGPA" class="form-control" />
                            <span asp-validation-for="CGPA" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Upload Resume (PDF only)</label>
                            <input type="file" class="form-control" accept=".pdf" />
                            <small class="text-muted" style="font-size: 0.75rem;">Max 5 MB. Stored with server-side GUID naming.</small>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CoverLetter" class="form-label small fw-semibold text-secondary">Candidate Statement / Cover Note</label>
                        <textarea asp-for="CoverLetter" rows="4" class="form-control small" placeholder="Summarize your interest, core technical projects, and placement goals..."></textarea>
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-4 small text-secondary">
                        <i class="bi bi-shield-lock-fill text-primary me-1"></i>
                        <strong>Duplicate Protection:</strong> SmartHire database constraints ensure you can only submit one official application per job opening.
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.JobId" class="btn btn-outline-secondary px-4 py-2 rounded-pill small">
                            Cancel
                        </a>
                        <button type="submit" class="btn cyber-btn-primary px-4 py-2.5 fw-bold shadow">
                            <i class="bi bi-check-circle me-1"></i>Confirm & Submit Application
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
