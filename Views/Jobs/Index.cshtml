@model SmartHire.ViewModels.JobSearchFilterViewModel
@{
    ViewData["Title"] = "Browse Verified Placement Jobs - SmartHire AI";
}

<div class="bg-dark text-white py-4 border-bottom border-secondary border-opacity-25" style="background: #0f172a !important;">
    <div class="container">
        <h1 class="h3 fw-bold text-white mb-1"><i class="bi bi-briefcase-fill text-info me-2"></i>Campus Placement Opportunities</h1>
        <p class="text-secondary small mb-0">Search and filter active campus recruitment openings verified by university administration.</p>
    </div>
</div>

<div class="container py-4">
    <!-- Filter Bar Card -->
    <div class="cyber-card p-4 shadow-sm mb-4">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-lg-4 col-md-6">
                <label class="form-label small fw-semibold text-secondary">Keyword / Skill / Company</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input name="keyword" value="@Model.Keyword" class="form-control" placeholder="e.g. .NET, SQL, CloudTech" />
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label small fw-semibold text-secondary">Location</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-geo-alt text-muted"></i></span>
                    <input name="location" value="@Model.Location" class="form-control" placeholder="e.g. Bangalore, Remote" />
                </div>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label small fw-semibold text-secondary">Job Type</label>
                <select name="jobType" class="form-select">
                    <option value="All">All Types</option>
                    <option value="Full-Time" selected="@(Model.JobType == "Full-Time")">Full-Time</option>
                    <option value="Internship" selected="@(Model.JobType == "Internship")">Internship</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label small fw-semibold text-secondary">Work Mode</label>
                <select name="workMode" class="form-select">
                    <option value="All">All Modes</option>
                    <option value="Hybrid" selected="@(Model.WorkMode == "Hybrid")">Hybrid</option>
                    <option value="Remote" selected="@(Model.WorkMode == "Remote")">Remote</option>
                    <option value="On-Site" selected="@(Model.WorkMode == "On-Site")">On-Site</option>
                </select>
            </div>
            <div class="col-lg-1 col-md-12">
                <button type="submit" class="btn cyber-btn-primary w-100 py-2">
                    <i class="bi bi-funnel-fill"></i>
                </button>
            </div>
        </form>
    </div>

    <!-- Active Jobs Count -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-dark mb-0">Showing @Model.TotalResults Active Job Listings</h5>
        <a asp-controller="Ai" asp-action="Assistant" class="badge neon-badge-ai text-decoration-none py-2 px-3">
            <i class="bi bi-stars me-1"></i>Check Your Match Ranking with AI
        </a>
    </div>

    <!-- Job Cards Grid -->
    <div class="row g-4">
        @foreach (var job in Model.Jobs)
        {
            <div class="col-lg-4 col-md-6">
                <div class="cyber-card p-4 h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge neon-badge-blue">@job.JobType</span>
                        <span class="text-muted small"><i class="bi bi-clock me-1"></i>@job.PostedAgo</span>
                    </div>

                    <h5 class="fw-bold text-dark mb-1">@job.Title</h5>
                    <p class="text-primary small fw-semibold mb-2">@job.CompanyName &bull; <i class="bi bi-geo-alt"></i> @job.Location (@job.WorkMode)</p>

                    <p class="text-secondary small leading-relaxed mb-3 flex-grow-1">
                        @job.Description
                    </p>

                    <div class="d-flex flex-wrap gap-1 mb-3">
                        @foreach (var skill in job.Skills)
                        {
                            <span class="badge bg-light text-dark border small">@skill</span>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light mb-3">
                        <div>
                            <span class="text-muted d-block small" style="font-size: 0.75rem;">Compensation</span>
                            <strong class="text-dark">@job.SalaryRange</strong>
                        </div>
                        <div class="text-end">
                            <span class="text-muted d-block small" style="font-size: 0.75rem;">Min CGPA</span>
                            <span class="badge bg-primary bg-opacity-10 text-primary">@job.MinimumCGPA+</span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-secondary w-50 py-1.5 small fw-semibold rounded-pill">
                            Details
                        </a>
                        <a asp-action="Apply" asp-route-id="@job.Id" class="btn cyber-btn-primary w-50 py-1.5 small fw-semibold text-center">
                            Apply Now
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
