@model SmartHire.ViewModels.JobItemViewModel
@{
    ViewData["Title"] = $"{Model.Title} at {Model.CompanyName} - SmartHire AI";
}

<div class="container py-5">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="cyber-card p-4 p-md-5 shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <div>
                        <span class="badge neon-badge-blue mb-2">@Model.JobType &bull; @Model.WorkMode</span>
                        <h2 class="fw-bold text-dark mb-1">@Model.Title</h2>
                        <h5 class="text-primary fw-semibold mb-0">@Model.CompanyName &bull; <i class="bi bi-geo-alt"></i> @Model.Location</h5>
                    </div>
                    <span class="badge bg-success bg-opacity-15 text-success p-2 px-3 fw-bold font-monospace fs-6">
                        <i class="bi bi-cpu me-1"></i>@Model.AiMatchPercent% AI Match
                    </span>
                </div>

                <div class="row g-3 p-3 bg-light rounded-4 mb-4">
                    <div class="col-sm-3 col-6">
                        <small class="text-muted d-block">Offered Package</small>
                        <strong class="text-dark">@Model.SalaryRange</strong>
                    </div>
                    <div class="col-sm-3 col-6">
                        <small class="text-muted d-block">Min. CGPA</small>
                        <strong class="text-primary">@Model.MinimumCGPA CGPA</strong>
                    </div>
                    <div class="col-sm-3 col-6">
                        <small class="text-muted d-block">Open Vacancies</small>
                        <strong class="text-dark">@Model.Vacancies Seats</strong>
                    </div>
                    <div class="col-sm-3 col-6">
                        <small class="text-muted d-block">Deadline</small>
                        <strong class="text-danger">@Model.Deadline</strong>
                    </div>
                </div>

                <h5 class="fw-bold text-dark mb-2">Role Overview</h5>
                <p class="text-secondary leading-relaxed mb-4">@Model.Description</p>

                <h5 class="fw-bold text-dark mb-2">Key Responsibilities</h5>
                <p class="text-secondary leading-relaxed mb-4">@Model.Responsibilities</p>

                <h5 class="fw-bold text-dark mb-2">Technical Qualifications & Requirements</h5>
                <p class="text-secondary leading-relaxed mb-4">@Model.Requirements</p>

                <h5 class="fw-bold text-dark mb-2">Target Skills</h5>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    @foreach (var s in Model.Skills)
                    {
                        <span class="badge bg-light text-dark border p-2 px-3 fw-medium">@s</span>
                    }
                </div>

                <div class="d-flex gap-3 pt-3 border-top">
                    <a asp-action="Apply" asp-route-id="@Model.Id" class="btn cyber-btn-primary px-4 py-2.5 fw-bold shadow">
                        <i class="bi bi-send-check me-2"></i>Apply with AI Profile
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2.5 rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i>Back to Listings
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- AI Recommendation Radar Card -->
            <div class="cyber-card p-4 shadow-sm mb-4">
                <div class="d-flex align-items-center gap-2 mb-3 text-info">
                    <i class="bi bi-robot fs-3"></i>
                    <h5 class="fw-bold text-dark mb-0">AI Fit Evaluation</h5>
                </div>
                <p class="text-secondary small mb-3">
                    Our AI parser checked this opening against student graduation cohorts:
                </p>
                <div class="d-flex flex-column gap-2 small">
                    <div class="d-flex justify-content-between p-2 rounded bg-light">
                        <span>CGPA Requirement</span>
                        <span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>Eligible</span>
                    </div>
                    <div class="d-flex justify-content-between p-2 rounded bg-light">
                        <span>Skill Overlap</span>
                        <span class="text-success fw-bold">4 of 5 Matched</span>
                    </div>
                    <div class="d-flex justify-content-between p-2 rounded bg-light">
                        <span>Predicted Shortlist Odds</span>
                        <span class="text-info fw-bold">High (Top 10%)</span>
                    </div>
                </div>
            </div>

            <!-- Company Overview Card -->
            <div class="cyber-card p-4 shadow-sm">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-building text-success me-2"></i>About Recruiter</h5>
                <h6 class="fw-bold mb-1">@Model.CompanyName</h6>
                <p class="text-muted small mb-3">Enterprise Cloud & IT Solutions Partner</p>
                <div class="small text-secondary mb-3">
                    <p class="mb-1"><i class="bi bi-patch-check-fill text-primary me-1"></i>Verified Campus Recruitment Partner</p>
                    <p class="mb-1"><i class="bi bi-clock-history text-muted me-1"></i>Drives Conducted: 4 Seasons</p>
                    <p class="mb-0"><i class="bi bi-people-fill text-muted me-1"></i>Alumni Employed: 32 Students</p>
                </div>
            </div>
        </div>
    </div>
</div>
