@{
    ViewData["Title"] = "About SmartHire";
}

<div class="container py-5">
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8 text-center">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold mb-2">Our Mission & Architecture</span>
            <h1 class="display-5 fw-bold text-dark">About SmartHire Portal</h1>
            <p class="lead text-muted">
                A college-level, enterprise-patterned web application built to streamline campus placement operations, candidate matching, and recruitment analytics.
            </p>
        </div>
    </div>

    <!-- Problem Statement vs Solution -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 border-start border-danger border-4">
                <div class="d-flex align-items-center gap-2 mb-3 text-danger">
                    <i class="bi bi-x-octagon-fill fs-3"></i>
                    <h4 class="fw-bold mb-0">The Problem</h4>
                </div>
                <p class="text-secondary">
                    Campus placement drives often rely on disconnected Google Forms, sprawling Excel spreadsheets, unvetted candidate emails, and lost resume versions. Placement officers struggle with verification, students miss deadlines or lack visibility into application statuses, and recruiters waste time filtering ineligible applicants.
                </p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 border-start border-success border-4">
                <div class="d-flex align-items-center gap-2 mb-3 text-success">
                    <i class="bi bi-check-circle-fill fs-3"></i>
                    <h4 class="fw-bold mb-0">The SmartHire Solution</h4>
                </div>
                <p class="text-secondary">
                    SmartHire establishes a unified, role-based platform. Verified corporate partners publish jobs with strict eligibility criteria; students maintain a single academic and skill profile with automated eligibility validation and match scoring; and placement officers monitor campus-wide hiring analytics and audit logs.
                </p>
            </div>
        </div>
    </div>

    <!-- Tech Stack Highlights -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-5">
        <h3 class="fw-bold mb-4 text-center">Engineered With Enterprise .NET Standards</h3>
        <div class="row g-4 text-center">
            <div class="col-lg-3 col-6">
                <div class="p-3 bg-light rounded-3">
                    <i class="bi bi-code-square fs-2 text-primary"></i>
                    <h6 class="fw-bold mt-2 mb-1">ASP.NET Core MVC</h6>
                    <small class="text-muted">Clean Separation of Concerns</small>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="p-3 bg-light rounded-3">
                    <i class="bi bi-database-check fs-2 text-success"></i>
                    <h6 class="fw-bold mt-2 mb-1">EF Core & SQL Server</h6>
                    <small class="text-muted">Code-First Migrations & Constraints</small>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="p-3 bg-light rounded-3">
                    <i class="bi bi-shield-lock-fill fs-2 text-warning"></i>
                    <h6 class="fw-bold mt-2 mb-1">ASP.NET Core Identity</h6>
                    <small class="text-muted">Role-Based Authorization & Security</small>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="p-3 bg-light rounded-3">
                    <i class="bi bi-pie-chart-fill fs-2 text-info"></i>
                    <h6 class="fw-bold mt-2 mb-1">Chart.js & Analytics</h6>
                    <small class="text-muted">Live Aggregated Reports</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Interview / Portfolio Summary -->
    <div class="alert alert-primary rounded-4 p-4 shadow-sm border-0">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-lightbulb-fill fs-2 text-primary"></i>
            <div>
                <h5 class="fw-bold mb-1">Demonstration & Interview Readiness</h5>
                <p class="mb-0 text-secondary">
                    Designed to showcase real-world full-stack competency: relational database constraints preventing duplicate applications, server-side authorization policies, transactional status auditing, rule-based recommendation algorithms, and secure file handling.
                </p>
            </div>
        </div>
    </div>
</div>
