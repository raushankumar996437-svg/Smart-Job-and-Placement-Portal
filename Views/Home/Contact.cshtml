@{
    ViewData["Title"] = "Contact Us";
}

<div class="container py-5">
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8 text-center">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold mb-2">Get In Touch</span>
            <h1 class="display-5 fw-bold text-dark">Placement Office & Support</h1>
            <p class="lead text-muted">
                Have questions regarding company registration, drive schedules, or portal technical assistance? Reach out to us.
            </p>
        </div>
    </div>

    <div class="row g-5">
        <!-- Contact Information Cards -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white h-100">
                <h4 class="fw-bold mb-4">Contact Details</h4>

                <div class="d-flex align-items-start gap-3 mb-4">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3">
                        <i class="bi bi-geo-alt-fill fs-4"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Campus Placement Cell</h6>
                        <p class="text-secondary small mb-0">Building 4, University Administrative Block, Tech Park Campus, Bangalore, Karnataka - 560100</p>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3 mb-4">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3">
                        <i class="bi bi-envelope-fill fs-4"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Official Email Address</h6>
                        <p class="text-secondary small mb-0">placements@smarthire.local</p>
                        <p class="text-secondary small mb-0">support@smarthire.local</p>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3 mb-4">
                    <div class="rounded-circle bg-warning bg-opacity-10 text-dark p-3">
                        <i class="bi bi-telephone-fill fs-4"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Helpline Hours</h6>
                        <p class="text-secondary small mb-0">+91 (0) 800-SMART-HIRE</p>
                        <small class="text-muted">Monday &ndash; Friday: 9:00 AM &ndash; 5:30 PM IST</small>
                    </div>
                </div>

                <hr class="my-4" />

                <div>
                    <h6 class="fw-bold mb-2">Are you a Recruiter?</h6>
                    <p class="text-secondary small">
                        Want to conduct an on-campus or virtual recruitment drive? Register your company profile to receive placement cell verification.
                    </p>
                </div>
            </div>
        </div>

        <!-- Contact / Query Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <h4 class="fw-bold mb-2">Send Us a Message</h4>
                <p class="text-muted small mb-4">Fill out the form below and our placement coordination team will get back to you within 24 business hours.</p>

                <form>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Full Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="e.g. John Doe" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Email Address <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" placeholder="e.g. john@example.com" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Role / Designation</label>
                            <select class="form-select">
                                <option value="Student">Current Student</option>
                                <option value="Recruiter">Corporate Recruiter</option>
                                <option value="Faculty">Faculty / Department Coordinator</option>
                                <option value="Other">Other Inquiry</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Subject <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="e.g. Drive Registration Inquiry" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Message / Inquiry Details <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="5" placeholder="Please describe your query in detail..." required></textarea>
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm" onclick="event.preventDefault(); alert('Thank you for reaching out! In Phase 1 this is a UI demonstration. In upcoming phases this connects to the placement ticketing service.');">
                                <i class="bi bi-send me-2"></i>Submit Message
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
