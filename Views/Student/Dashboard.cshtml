@{
    ViewData["Title"] = "Student Placement Dashboard - SmartHire AI";
    var recommended = ViewBag.RecommendedJobs as List<SmartHire.ViewModels.JobItemViewModel> ?? new();
}

<div class="bg-dark text-white py-4 border-bottom border-secondary border-opacity-25" style="background: #0f172a !important;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <span class="badge neon-badge-blue mb-1">Student Portal</span>
                <h1 class="h3 fw-bold text-white mb-0">Welcome back, Raushan Kumar!</h1>
                <p class="text-secondary small mb-0">B.Tech Computer Science & Engineering &bull; CGPA: 8.7 &bull; Batch 2026</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Ai" asp-action="Assistant" class="btn cyber-btn-ai btn-sm px-3 py-2 fw-semibold">
                    <i class="bi bi-robot me-1"></i>AI ATS Analyzer
                </a>
                <a asp-controller="Jobs" asp-action="Index" class="btn cyber-btn-primary btn-sm px-3 py-2 fw-semibold">
                    <i class="bi bi-search me-1"></i>Find Openings
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    <!-- Top Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="cyber-card p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase">Total Applications</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">4</h3>
                    </div>
                    <span class="rounded-circle bg-primary bg-opacity-10 text-primary p-3">
                        <i class="bi bi-file-earmark-text fs-4"></i>
                    </span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="cyber-card p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase">Under Review</span>
                        <h3 class="fw-bold text-warning mt-1 mb-0">2</h3>
                    </div>
                    <span class="rounded-circle bg-warning bg-opacity-10 text-warning p-3">
                        <i class="bi bi-clock-history fs-4"></i>
                    </span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="cyber-card p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase">Shortlisted</span>
                        <h3 class="fw-bold text-info mt-1 mb-0">1</h3>
                    </div>
                    <span class="rounded-circle bg-info bg-opacity-10 text-info p-3">
                        <i class="bi bi-trophy fs-4"></i>
                    </span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="cyber-card p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase">Interviews Active</span>
                        <h3 class="fw-bold text-success mt-1 mb-0">1</h3>
                    </div>
                    <span class="rounded-circle bg-success bg-opacity-10 text-success p-3">
                        <i class="bi bi-camera-video fs-4"></i>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Applications Table Column -->
        <div class="col-lg-8">
            <div class="cyber-card p-4 shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-journal-check text-primary me-2"></i>My Application Pipeline</h5>
                    <span class="text-muted small">Updated in real-time</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-secondary">
                            <tr>
                                <th>Role & Company</th>
                                <th>Applied Date</th>
                                <th>Status</th>
                                <th>AI Match</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            <tr>
                                <td>
                                    <strong class="text-dark d-block">Junior .NET Software Engineer</strong>
                                    <span class="text-muted">CloudTech Systems &bull; Hybrid</span>
                                </td>
                                <td>20 Nov 2026</td>
                                <td>
                                    <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 px-2.5 py-1">
                                        <i class="bi bi-calendar-check me-1"></i>Interview Scheduled
                                    </span>
                                </td>
                                <td><span class="fw-bold font-monospace text-primary">94%</span></td>
                                <td>
                                    <button class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-1" onclick="alert('Interview Details:\nDate: 25 Nov 2026, 11:00 AM IST\nMode: Virtual (Google Meet)\nInterviewer: Lead Tech Architect')">
                                        View Details
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong class="text-dark d-block">Full-Stack Web Developer</strong>
                                    <span class="text-muted">NextGen Digital Labs &bull; Remote</span>
                                </td>
                                <td>18 Nov 2026</td>
                                <td>
                                    <span class="badge bg-info bg-opacity-15 text-info border border-info border-opacity-25 px-2.5 py-1">
                                        <i class="bi bi-star-fill me-1"></i>Shortlisted
                                    </span>
                                </td>
                                <td><span class="fw-bold font-monospace text-primary">89%</span></td>
                                <td>
                                    <span class="text-muted small">Round 1 Cleared</span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong class="text-dark d-block">Associate Database Engineer</strong>
                                    <span class="text-muted">DataMatrix Solutions &bull; Pune</span>
                                </td>
                                <td>14 Nov 2026</td>
                                <td>
                                    <span class="badge bg-warning bg-opacity-15 text-dark border border-warning border-opacity-25 px-2.5 py-1">
                                        <i class="bi bi-hourglass-split me-1"></i>Under Review
                                    </span>
                                </td>
                                <td><span class="fw-bold font-monospace text-primary">82%</span></td>
                                <td>
                                    <span class="text-muted small">HR Reviewing</span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong class="text-dark d-block">Frontend UI/UX Developer</strong>
                                    <span class="text-muted">PixelCraft Technologies</span>
                                </td>
                                <td>10 Nov 2026</td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-15 text-secondary px-2.5 py-1">
                                        Applied
                                    </span>
                                </td>
                                <td><span class="fw-bold font-monospace text-primary">78%</span></td>
                                <td>
                                    <span class="text-muted small">Queue #14</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Upcoming Interview Callout -->
            <div class="cyber-card p-4 shadow-sm border-start border-success border-4 mb-4">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="spinner-grow spinner-grow-sm text-success" role="status"></span>
                        <h5 class="fw-bold text-dark mb-0">Upcoming Technical Interview</h5>
                    </div>
                    <span class="badge bg-success text-white">Confirmed</span>
                </div>
                <h6 class="text-primary fw-semibold mb-1">Junior .NET Software Engineer &bull; CloudTech Systems</h6>
                <p class="text-secondary small mb-3">
                    <i class="bi bi-calendar3 me-1"></i><strong>Date & Time:</strong> Wednesday, 25 Nov 2026 &bull; 11:00 AM - 12:00 PM IST<br />
                    <i class="bi bi-camera-video me-1"></i><strong>Platform:</strong> Google Meet Virtual Session (Link activated 15 mins prior)<br />
                    <i class="bi bi-info-circle me-1"></i><strong>Round Focus:</strong> C# OOP Principles, ASP.NET Core MVC architecture, EF Core query performance, and live coding.
                </p>
                <div class="d-flex gap-2">
                    <a href="https://meet.google.com" target="_blank" class="btn btn-sm btn-success rounded-pill px-3 fw-semibold">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Test Meeting Link
                    </a>
                    <a asp-controller="Ai" asp-action="Assistant" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        <i class="bi bi-robot me-1"></i>Prepare with AI Questions
                    </a>
                </div>
            </div>
        </div>

        <!-- Right Side: Profile & Quick Links -->
        <div class="col-lg-4">
            <!-- Profile Card -->
            <div class="cyber-card p-4 shadow-sm mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-4" style="width: 52px; height: 52px;">
                        RK
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-0">Raushan Kumar</h5>
                        <p class="text-muted small mb-0">NIT Tech Campus &bull; Roll: 2026CS104</p>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-secondary">Profile Strength</span>
                        <span class="text-primary fw-bold">85%</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: 85%;"></div>
                    </div>
                </div>

                <div class="small text-secondary mb-3">
                    <div class="mb-1"><strong>Skills:</strong> C#, ASP.NET Core, SQL Server, EF Core, JS</div>
                    <div class="mb-1"><strong>Resume:</strong> <span class="text-success"><i class="bi bi-check-circle-fill"></i> Verified_Resume_v2.pdf</span></div>
                    <div><strong>LinkedIn:</strong> <a href="#" class="text-primary text-decoration-none">linkedin.com/in/raushan</a></div>
                </div>

                <a asp-action="RegisterStudent" asp-controller="Account" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                    <i class="bi bi-pencil-square me-1"></i>Edit Profile & Skills
                </a>
            </div>

            <!-- Recommended Openings Mini Card -->
            <div class="cyber-card p-4 shadow-sm">
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-stars text-warning me-1"></i>Hot Opportunities For You</h6>
                <div class="d-flex flex-column gap-3">
                    @foreach (var r in recommended)
                    {
                        <div class="border-bottom pb-2">
                            <strong class="text-dark small d-block">@r.Title</strong>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <small class="text-muted">@r.CompanyName</small>
                                <a asp-controller="Jobs" asp-action="Details" asp-route-id="@r.Id" class="badge bg-primary text-decoration-none">View</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
