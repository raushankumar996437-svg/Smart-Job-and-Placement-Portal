@model SmartHire.ViewModels.RecruiterRegisterViewModel
@{
    ViewData["Title"] = "Corporate Recruiter Registration - SmartHire AI";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="cyber-card p-4 p-md-5 shadow-lg">
                <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                    <span class="rounded-circle bg-success bg-opacity-10 text-success p-3">
                        <i class="bi bi-building-fill fs-2"></i>
                    </span>
                    <div>
                        <h2 class="fw-bold text-dark tracking-tight mb-0">Register Your Company</h2>
                        <p class="text-secondary small mb-0">Join our placement ecosystem to hire top graduating talent</p>
                    </div>
                </div>

                <form asp-action="RegisterRecruiter" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small mb-3"></div>

                    <!-- Company Profile -->
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-buildings text-success me-2"></i>Company Information</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="CompanyName" class="form-control" placeholder="e.g. CloudTech Systems Pvt Ltd" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OfficialEmail" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="OfficialEmail" class="form-control" placeholder="careers@cloudtech.com" />
                            <span asp-validation-for="OfficialEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Website" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Website" class="form-control" placeholder="https://www.cloudtech.com" />
                            <span asp-validation-for="Website" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Industry" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="Industry" class="form-select">
                                <option value="Information Technology">Information Technology / Software</option>
                                <option value="Cloud Computing & DevOps">Cloud Computing & DevOps</option>
                                <option value="Financial Services & Fintech">Financial Services & Fintech</option>
                                <option value="Healthcare & BioTech">Healthcare & BioTech</option>
                                <option value="Consulting & Analytics">Consulting & Analytics</option>
                            </select>
                            <span asp-validation-for="Industry" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CompanySize" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="CompanySize" class="form-select">
                                <option value="1-50 Employees">1 - 50 Employees (Startup)</option>
                                <option value="50-250 Employees">50 - 250 Employees (Mid-size)</option>
                                <option value="250-1000 Employees">250 - 1000 Employees (Large Enterprise)</option>
                                <option value="1000+ Employees">1000+ Employees (MNC)</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label small fw-semibold text-secondary"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Briefly describe your company, work culture, and domain..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Contact Person -->
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person-badge text-primary me-2"></i>Recruiter Contact Details</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="ContactPerson" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="ContactPerson" class="form-control" placeholder="e.g. Ananya Sharma" />
                            <span asp-validation-for="ContactPerson" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Designation" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Designation" class="form-control" placeholder="e.g. Lead Talent Partner" />
                            <span asp-validation-for="Designation" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Login" class="text-decoration-none text-secondary small">
                            Already registered? <strong class="text-success">Sign in</strong>
                        </a>
                        <button type="submit" class="btn btn-success px-4 py-2.5 fw-bold shadow rounded-pill">
                            <i class="bi bi-send-check me-1"></i>Submit for Verification
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
