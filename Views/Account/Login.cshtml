@model SmartHire.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Portal Login - SmartHire AI";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-8">
            <div class="cyber-card p-4 p-md-5 shadow-lg">
                <div class="text-center mb-4">
                    <span class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-inline-flex mb-3">
                        <i class="bi bi-shield-lock-fill fs-2"></i>
                    </span>
                    <h2 class="fw-bold text-dark tracking-tight">Welcome Back</h2>
                    <p class="text-secondary small">Sign in to your SmartHire placement account</p>
                </div>

                <!-- Role Selector Pills -->
                <div class="d-flex justify-content-center gap-2 mb-4 p-1 bg-light rounded-pill border">
                    <button type="button" class="btn btn-sm rounded-pill px-3 py-1 fw-bold role-pill active bg-primary text-white" onclick="setRole('Student', this)">
                        <i class="bi bi-mortarboard me-1"></i>Student
                    </button>
                    <button type="button" class="btn btn-sm rounded-pill px-3 py-1 fw-bold role-pill text-secondary" onclick="setRole('Recruiter', this)">
                        <i class="bi bi-building me-1"></i>Recruiter
                    </button>
                    <button type="button" class="btn btn-sm rounded-pill px-3 py-1 fw-bold role-pill text-secondary" onclick="setRole('Admin', this)">
                        <i class="bi bi-shield-check me-1"></i>Admin
                    </button>
                </div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Role" id="selectedRoleInput" />
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                            <input asp-for="Email" class="form-control border-start-0" id="loginEmail" placeholder="e.g. raushan@student.college.edu" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                            <a href="javascript:void(0)" onclick="alert('Password reset link sent to registered email in demo mode!')" class="small text-primary text-decoration-none">Forgot?</a>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
                            <input asp-for="Password" class="form-control border-start-0" id="loginPassword" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-secondary"></label>
                    </div>

                    <button type="submit" class="btn cyber-btn-primary w-100 py-2.5 fw-bold shadow">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Sign In to Portal
                    </button>
                </form>

                <!-- Quick Demo Autofill -->
                <div class="mt-4 pt-3 border-top text-center">
                    <small class="text-muted d-block mb-2">⚡ Quick Demo One-Click Fill:</small>
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 rounded" onclick="autoFill('student@college.edu', 'Pass@123', 'Student')">
                            Student Demo
                        </button>
                        <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 rounded" onclick="autoFill('recruiter@cloudtech.com', 'Pass@123', 'Recruiter')">
                            Recruiter Demo
                        </button>
                        <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 rounded" onclick="autoFill('admin@smarthire.local', 'Pass@123', 'Admin')">
                            Admin Demo
                        </button>
                    </div>
                </div>

                <div class="mt-4 text-center">
                    <span class="text-secondary small">Don't have an account?</span>
                    <a asp-action="RegisterStudent" class="fw-bold text-primary text-decoration-none small ms-1">Register as Student</a>
                    <span class="text-muted small">&bull;</span>
                    <a asp-action="RegisterRecruiter" class="fw-bold text-success text-decoration-none small ms-1">Register as Recruiter</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setRole(role, btn) {
            document.getElementById('selectedRoleInput').value = role;
            document.querySelectorAll('.role-pill').forEach(b => {
                b.classList.remove('active', 'bg-primary', 'text-white');
                b.classList.add('text-secondary');
            });
            btn.classList.add('active', 'bg-primary', 'text-white');
            btn.classList.remove('text-secondary');
        }

        function autoFill(email, pass, role) {
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = pass;
            document.getElementById('selectedRoleInput').value = role;
        }
    </script>
}
